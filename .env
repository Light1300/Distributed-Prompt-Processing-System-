POSTGRES_USER=promptuser
POSTGRES_PASSWORD=promptpass
POSTGRES_DB=promptdb
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

DATABASE_URL=postgresql+asyncpg://promptuser:<password>@postgres:5432/promptdb
DATABASE_URL_SYNC=postgresql+psycopg2://promptuser:<password>@postgres:5432/promptdb

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

RATE_LIMIT_MAX_CALLS=300
RATE_LIMIT_WINDOW_SECONDS=60

CACHE_SIMILARITY_THRESHOLD=0.9
EMBEDDING_MODEL=all-MiniLM-L6-v2
USE_MOCK_EMBEDDINGS=false

LLM_LATENCY_MIN_MS=200
LLM_LATENCY_MAX_MS=500
LLM_FAILURE_RATE=0.05
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY=1.0

API_V1_PREFIX=/v1

FLOWER_USER=admin
FLOWER_PASSWORD=admin

LOG_LEVEL=INFO
LOG_FORMAT=json
